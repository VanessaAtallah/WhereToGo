@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool hideNavbar = controller == "Account" && (action == "Login" || action == "Register");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Where To Go?</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
        /* ---------- Navbar Styles ---------- */
        .navbar-custom {
            background-color: #88E788;
            border-bottom: 4px solid #f1f3f0;
        }

        .sticky-top {
            margin: 10px 20px;
            border-radius: 50px;
            top: 15px;
        }

        .navbar-brand {
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #157347 !important;
            font-size: 1.4rem;
        }

            .navbar-brand i {
                color: #ff7f50;
                filter: drop-shadow(0 2px 4px rgba(255, 127, 80, 0.4));
            }

        /* Navigation Links */
        .nav-link {
            color: #444 !important;
            font-weight: 600;
            margin: 0 10px;
            position: relative;
            padding: 8px 15px !important;
            transition: all 0.3s ease;
        }

            /* Sliding Underline Effect */
            .nav-link::after {
                content: '';
                position: absolute;
                width: 0;
                height: 3px;
                bottom: 0;
                left: 50%;
                background: #157347;
                transition: all 0.3s ease;
                transform: translateX(-50%);
                border-radius: 10px;
            }

            .nav-link:hover::after,
            .nav-link.active::after {
                width: 60%;
            }

            .nav-link:hover {
                color: #157347 !important;
                transform: translateY(-2px);
            }

            .nav-link.active {
                color: #157347 !important;
            }

            /* Icon Animation */
            .nav-link i {
                font-size: 1.1rem;
                transition: transform 0.3s ease;
            }

            .nav-link:hover i {
                transform: rotate(-10deg) scale(1.2);
            }

        /* Add Place Button*/
        .btn-add-place {
            background: linear-gradient(135deg, #157347 0%, #2ecc71 100%);
            color: white !important;
            border-radius: 25px;
            padding: 8px 20px !important;
            box-shadow: 0 4px 15px rgba(21, 115, 71, 0.3);
        }

            .btn-add-place::after {
                display: none !important;
            }

            .btn-add-place:hover {
                box-shadow: 0 6px 20px rgba(21, 115, 71, 0.4);
                transform: translateY(-3px) scale(1.05) !important;
            }
    </style>
</head>
<body>
    @if (!hideNavbar)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-custom sticky-top">
                <div class="container">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-location-dot"></i> WhereToGo
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Home" && action == "Index" ? "active" : "")"
                                   asp-area="" asp-controller="Home" asp-action="Index">
                                    Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "SavedPlaces" && action == "MySavedPlaces" ? "active" : "")"
                                   asp-area="" asp-controller="SavedPlaces" asp-action="MySavedPlaces">
                                    <i class="fa-regular fa-bookmark me-1"></i> Saved
                                </a>
                            </li>
                            <li class="nav-item ms-lg-3">
                                <a class="nav-link btn-add-place @(controller == "Place" && action == "Create" ? "active" : "")"
                                   asp-area="" asp-controller="Place" asp-action="Create">
                                    <i class="fa-solid fa-plus me-1"></i> Add Place
                                </a>
                            </li>

                            <!-- Login / Logout -->
                            <li class="nav-item ms-lg-3">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-success btn-sm">
                                            <i class="fas fa-sign-out-alt"></i> Logout
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-success btn-sm">Login</a>
                                }
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted mt-5">
        <div class="container">
            &copy; 2026 - Where To Go?
        </div>
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>